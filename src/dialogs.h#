pub struct DialogResult is
    pub ok: int
    pub button: int
    pub cursor: int
    pub selected: [int]
    pub text: string
end

;; zawijanie słów do width komórek
fn wrap_text(text: string, width: int) -> [string] is
    let mut out: [string] = []
    let paras: [string] = string_split(text, "\n")
    let mut p: int = 0
    while p < paras.len() is
        let words: [string] = string_split(paras[p], " ")
        let mut cur: string = ""
        let mut w: int = 0
        while w < words.len() is
            let wd: string = words[w]
            if cur == "" is
                cur = wd
            elsif utf8::str_width(cur) + 1 + utf8::str_width(wd) <= width is
                cur = cur + " " + wd
            else is
                out.push(cur)
                cur = wd
            end
            w += 1
        end
        out.push(cur)
        p += 1
    end
    return out
end

fn center(s: string, width: int) -> string is
    let w: int = utf8::str_width(s)
    if w >= width is return utf8::truncate(s, width) end
    let left: int = (width - w) / 2
    return utf8::spaces(left) + s + utf8::spaces(width - w - left)
end

fn paint(code: string, text: string, back: string) -> string is
    if code == "" is return text end
    return "\x1b[" + code + "m" + text + "\x1b[0m" + back
end

fn buttons_row(st: style::Style, depth: int, labels: [string], focus: int, iw: int, back: string) -> string is
    let mut plain: string = ""
    let mut i: int = 0
    while i < labels.len() is
        if i > 0 is plain = plain + "  " end
        plain = plain + "< " + labels[i] + " >"
        i += 1
    end
    let total: int = utf8::str_width(plain)
    let left: int = (iw - total) / 2
    let mut o: string = utf8::spaces(left)
    let focused: string = style::sgr(st, "class:button.focused", depth)
    let mut k: int = 0
    while k < labels.len() is
        if k > 0 is o = o + "  " end
        let btn: string = "< " + labels[k] + " >"
        if k == focus is o = o + paint(focused, btn, back) else is o = o + btn end
        k += 1
    end
    return o + utf8::spaces(iw - left - total)
end

;; rysuje ramkę z gotowymi (już wypełnionymi do iw komórek) wierszami
fn frame(t: term::Term, st: style::Style, depth: int, title: string, rows: [string], iw: int) is
    let body: string = style::sgr(st, "class:dialog.body", depth)
    let bg: string = style::sgr(st, "class:dialog", depth)
    let tcode: string = style::sgr(st, "class:dialog.title", depth)
    let mut back: string = ""
    if body != "" is back = "\x1b[" + body + "m" end
    let h: int = rows.len() + 2
    let w: int = iw + 4
    let mut top: int = (t.rows - h) / 2 + 1
    if top < 1 is top = 1 end
    let mut left: int = (t.cols - w) / 2 + 1
    if left < 1 is left = 1 end
    let mut o: string = "\x1b[0m"
    if bg != "" is o = o + "\x1b[" + bg + "m" end
    o = o + "\x1b[2J"
    let mut head: string = "┌" + string_repeat("─", w - 2) + "┐"
    if title != "" is
        let tt: string = " " + utf8::truncate(title, w - 6) + " "
        let tw: int = utf8::str_width(tt)
        let l1: int = (w - 2 - tw) / 2
        head = "┌" + string_repeat("─", l1) + paint(tcode, tt, back) + string_repeat("─", w - 2 - tw - l1) + "┐"
    end
    o = o + "\x1b[" + to_string(top) + ";" + to_string(left) + "H" + paint(body, head, back)
    let mut i: int = 0
    while i < rows.len() is
        let content: string = string_replace(rows[i], "\x1b[0m", "\x1b[0m" + back)
        o = o + "\x1b[" + to_string(top + 1 + i) + ";" + to_string(left) + "H"
        if body != "" is o = o + "\x1b[" + body + "m" end
        o = o + "│ " + content + " │" + "\x1b[0m"
        i += 1
    end
    o = o + "\x1b[" + to_string(top + h - 1) + ";" + to_string(left) + "H"
    o = o + paint(body, "└" + string_repeat("─", w - 2) + "┘", back)
    term::out(o)
end

fn list_row(st: style::Style, depth: int, text: string, focused: int, iw: int, back: string) -> string is
    let padded: string = utf8::pad(text, iw)
    if focused == 1 is
        return paint(style::sgr(st, "class:button.focused", depth), padded, back)
    end
    return padded
end

fn has(a: [int], v: int) -> bool is
    let mut i: int = 0
    while i < a.len() is
        if a[i] == v is return true end
        i += 1
    end
    return false
end

fn without(a: [int], v: int) -> [int] is
    let mut r: [int] = []
    let mut i: int = 0
    while i < a.len() is
        if a[i] != v is r.push(a[i]) end
        i += 1
    end
    return r
end

;; kind: "message" | "buttons" | "input" | "radio" | "check"
fn run(title: string, text: string, kind: string, items: [string], buttons: [string], init_text: string, password: int, init_sel: [int], init_cursor: int) -> DialogResult is
    let res: DialogResult = DialogResult { ok: 0, button: -1, cursor: init_cursor, selected: init_sel, text: init_text }
    let t: term::Term = term::new_term()
    if t.tty_in == 0 is return res end
    term::refresh_size(t)
    let st: style::Style = style::default_style()
    let depth: int = style::color_depth()
    let mut iw: int = utf8::str_width(title) + 2
    if iw < 30 is iw = 30 end
    let mut k: int = 0
    while k < items.len() is
        let need: int = utf8::str_width(items[k]) + 6
        if need > iw is iw = need end
        k += 1
    end
    if iw > t.cols - 8 is iw = t.cols - 8 end
    let lines: [string] = wrap_text(text, iw)
    let b: buffer::Buffer = buffer::new_buffer(init_text)
    let mut area: int = 0
    if kind == "message" || kind == "buttons" is area = 1 end
    let mut btn: int = 0
    let mut cursor: int = init_cursor
    let mut done: int = 0
    term::enter_raw(t)
    term::out("\x1b[?1049h\x1b[?25l")
    while done == 0 is
        let body: string = style::sgr(st, "class:dialog.body", depth)
        let mut back: string = ""
        if body != "" is back = "\x1b[" + body + "m" end
        let mut rows: [string] = []
        let mut i: int = 0
        while i < lines.len() is
            rows.push(utf8::pad(lines[i], iw))
            i += 1
        end
        if kind == "input" is
            rows.push(utf8::spaces(iw))
            let mut shown: string = string_slice(b.text, 0, string_len(b.text))
            if password == 1 is shown = string_repeat("*", utf8::char_count(b.text)) end
            let before: string = utf8::truncate(string_slice(shown, 0, buffer_cursor_bytes(shown, b)), iw - 2)
            let rest: string = string_slice(shown, string_len(before), string_len(shown))
            let mut cur: string = " "
            let mut after: string = ""
            if rest != "" is
                cur = utf8::char_at(rest, 0)
                after = string_slice(rest, string_len(cur), string_len(rest))
            end
            let used: int = utf8::str_width(before) + utf8::str_width(cur) + utf8::str_width(after)
            let field: string = before + paint("7", cur, back) + after + utf8::spaces(iw - used)
            rows.push(field)
        end
        if kind == "radio" || kind == "check" is
            rows.push(utf8::spaces(iw))
            let mut j: int = 0
            while j < items.len() is
                let mut mark: string = "[ ] "
                if kind == "radio" is mark = "( ) " end
                if has(res.selected, j) is
                    if kind == "radio" is mark = "(*) " else is mark = "[x] " end
                end
                let foc: int = 0
                let mut f: int = 0
                if area == 0 && j == cursor is f = 1 end
                rows.push(list_row(st, depth, mark + items[j], f, iw, back))
                j += 1
            end
        end
        rows.push(utf8::spaces(iw))
        rows.push(buttons_row(st, depth, buttons, btn, iw, back))
        frame(t, st, depth, title, rows, iw)
        let key: string = term::read_key(t)
        if key == "c-c" || key == "escape" is
            res.ok = 0
            res.button = -1
            done = 1
        end
        if key == "tab" || key == "s-tab" is
            if kind == "radio" || kind == "check" || kind == "input" is
                if area == 0 is area = 1 else is area = 0 end
            else is
                if key == "tab" is btn = (btn + 1) % buttons.len() else is btn = (btn + buttons.len() - 1) % buttons.len() end
            end
        end
        if key == "enter" is
            res.button = btn
            res.ok = 1
            if kind == "buttons" is res.ok = 1 end
            if btn > 0 && kind != "buttons" is res.ok = 0 end
            if kind == "radio" && area == 0 is
                res.selected = [cursor]
                area = 1
                res.ok = 0
                res.button = -1
            else is
                done = 1
            end
        end
        if area == 1 is
            if key == "left" is btn = (btn + buttons.len() - 1) % buttons.len() end
            if key == "right" is btn = (btn + 1) % buttons.len() end
            if key == "up" && (kind == "radio" || kind == "check" || kind == "input") is area = 0 end
        else is
            if kind == "input" is
                if key == "left" is buffer::left(b, 1) end
                if key == "right" is buffer::right(b, 1) end
                if key == "home" || key == "c-a" is buffer::home(b) end
                if key == "end" || key == "c-e" is buffer::end_of_line(b) end
                if key == "backspace" is buffer::delete_back(b, 1) end
                if key == "delete" is buffer::delete_fwd(b, 1) end
                if utf8::char_count(key) == 1 && utf8::cp_at(key, 0) >= 32 is buffer::insert(b, key) end
                if key == "down" is area = 1 end
            else is
                if key == "up" && cursor > 0 is cursor -= 1 end
                if key == "down" is
                    if cursor < items.len() - 1 is cursor += 1 else is area = 1 end
                end
                if key == " " is
                    if kind == "radio" is
                        res.selected = [cursor]
                    else is
                        if has(res.selected, cursor) is res.selected = without(res.selected, cursor) else is res.selected.push(cursor) end
                    end
                end
            end
        end
    end
    term::out("\x1b[?1049l\x1b[?25h")
    term::leave_raw(t)
    res.cursor = cursor
    res.text = b.text
    if kind == "buttons" && res.button >= 0 is res.ok = 1 end
    return res
end

fn buffer_cursor_bytes(shown: string, b: buffer::Buffer) -> int is
    let c: int = utf8::char_count(string_slice(b.text, 0, b.pos))
    let mut p: int = 0
    let mut i: int = 0
    while i < c is
        p = utf8::next(shown, p)
        i += 1
    end
    return p
end

pub fn message_dialog(title: string, text: string, ok_label: string) is
    let r: DialogResult = run(title, text, "message", [], [ok_label], "", 0, [], 0)
end

;; 1 = Yes, 0 = No / anulowano
pub fn yes_no_dialog(title: string, text: string) -> bool is
    let r: DialogResult = run(title, text, "buttons", [], ["Yes", "No"], "", 0, [], 0)
    return r.button == 0
end

;; indeks wciśniętego przycisku lub -1 (anulowano)
pub fn button_dialog(title: string, text: string, labels: [string]) -> int is
    let r: DialogResult = run(title, text, "buttons", [], labels, "", 0, [], 0)
    return r.button
end

;; r.ok == 1 gdy zatwierdzono OK; r.text = wpisany tekst
pub fn input_dialog(title: string, text: string, password: int, initial: string) -> DialogResult is
    return run(title, text, "input", [], ["OK", "Cancel"], initial, password, [], 0)
end

;; indeks wybranej wartości lub -1
pub fn radiolist_dialog(title: string, text: string, values: [string], default_idx: int) -> int is
    let mut sel: [int] = []
    if default_idx >= 0 is sel = [default_idx] end
    let mut cur: int = default_idx
    if cur < 0 is cur = 0 end
    let r: DialogResult = run(title, text, "radio", values, ["Ok", "Cancel"], "", 0, sel, cur)
    if r.ok == 0 || r.selected.len() == 0 is return -1 end
    return r.selected[0]
end

;; r.ok == 1 gdy zatwierdzono; r.selected = indeksy zaznaczonych wartości
pub fn checkboxlist_dialog(title: string, text: string, values: [string], defaults: [int]) -> DialogResult is
    return run(title, text, "check", values, ["Ok", "Cancel"], "", 0, defaults, 0)
end
