;; Szerokosc napisu w komorkach terminala (znaki szerokie/emoji = 2, ANSI nie jest brane pod uwage).
pub fn str_width(text: string) -> int is
    return utf8::str_width(text)
end

;; Liczba kolumn terminala (ioctl TIOCGWINSZ, potem $COLUMNS, domyslnie 80).
pub fn terminal_width() -> int is
    let t: term::Term = term::new_term()
    term::refresh_size(t)
    return t.cols
end

;; Uruchamia polecenie w `sh -c` z pelnym dostepem do terminala i zwraca kod wyjscia
;; (jak `$?`: 128+N, gdy proces zginal od sygnalu N). Wolac PO zakonczeniu `prompt` —
;; wtedy terminal jest juz w trybie cooked.
pub fn run_command(cmd: string) -> int is
    let st: int = term::run_interactive(cmd)
    let sig: int = st % 128
    if sig != 0 is return 128 + sig end
    return (st / 256) % 256
end
