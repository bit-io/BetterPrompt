;; ───────────────────────── Sesja i prompt ─────────────────────────

pub fn new_session() -> session::PromptSession is
    return session::new_session()
end

;; Czyta linię. Po zakończeniu: session_interrupted(s) (Ctrl-C) / session_eof(s) (Ctrl-D).
pub fn prompt(s: session::PromptSession) -> string is
    return session::prompt(s)
end

pub fn session_interrupted(s: session::PromptSession) -> bool is
    return s.status == 1
end

pub fn session_eof(s: session::PromptSession) -> bool is
    return s.status == 2
end

;; jednorazowy prompt bez historii: betterprompt::ask("Imię: ")
pub fn ask(message: string) -> string is
    let s: session::PromptSession = session::new_session()
    session::set_message(s, message)
    return session::prompt(s)
end

pub fn ask_password(message: string) -> string is
    let s: session::PromptSession = session::new_session()
    session::set_message(s, message)
    s.is_password = 1
    return session::prompt(s)
end

pub fn set_message(s: session::PromptSession, text: string) is
    session::set_message(s, text)
end

