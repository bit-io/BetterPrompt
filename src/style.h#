mod utf8

const C255: int = 255
const C256: int = 256
const C231: int = 231
const C232: int = 232
const C247: int = 247
const C248: int = 248

pub struct Fragment is
    pub style: string
    pub text: string
end

pub fn frag(style: string, text: string) -> Fragment is
    return Fragment { style: style, text: text }
end

pub struct Style is
    pub names: [string]
    pub rules: [string]
end

pub fn new_style() -> Style is
    return Style { names: [], rules: [] }
end

;; dodaje/nadpisuje regułę, np. style_add(st, "completion-menu.current", "bg:#00aaaa fg:black bold")
pub fn style_add(st: Style, name: string, rule: string) is
    let mut i: int = 0
    while i < st.names.len() is
        if st.names[i] == name is
            st.rules[i] = rule
            return
        end
        i += 1
    end
    st.names.push(name)
    st.rules.push(rule)
end

;; styl domyślny (odpowiednik domyślnego stylu prompt_toolkit)
